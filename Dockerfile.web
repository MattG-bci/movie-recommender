FROM nginx:1.27-alpine

COPY mobile/build/web /usr/share/nginx/html
COPY infra/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY mobile/web/config.js.template /usr/share/nginx/config.js.template
COPY --chmod=755 infra/nginx/40-generate-runtime-config.sh /docker-entrypoint.d/40-generate-runtime-config.sh

EXPOSE 80
